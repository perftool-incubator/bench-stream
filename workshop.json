{
  "workshop": {
    "schema": {
      "version": "2025.07.25"
    }
  },
  "userenvs": [
    {
      "name": "default",
      "requirements": [
        "stream_build_tools",
        "stream_build_driver",
        "stream_upstream"
      ]
    },
    {
      "name": [
        "alma8",
        "rhubi8"
      ],
      "requirements": [
        "stream_build_tools",
        "stream_build_driver",
        "stream_python312_default",
        "stream_upstream"
      ]
    }
  ],
  "requirements": [
    {
      "name": "stream_build_tools",
      "type": "distro",
      "distro_info": {
        "packages": [
          "gcc",
          "numactl",
          "python3",
          "tar"
        ]
      }
    },
    {
      "name": "stream_build_driver",
      "type": "files",
      "files_info": {
        "files": [
          {
            "src": "%bench-dir%/stream-build.py",
            "dst": "/tmp/stream-build.py"
          },
          {
            "src": "%bench-dir%/stream_common.py",
            "dst": "/tmp/stream_common.py"
          },
          {
            "src": "%bench-dir%/third-party/STREAM-5.10-LICENSE.txt",
            "dst": "/tmp/STREAM-5.10-LICENSE.txt"
          },
          {
            "src": "%bench-dir%/third-party/NOTICE.txt",
            "dst": "/tmp/STREAM-NOTICE.txt"
          },
          {
            "src": "%bench-dir%/LICENSE",
            "dst": "/tmp/STREAM-ADAPTER-LICENSE.txt"
          }
        ]
      }
    },
    {
      "name": "stream_python312_default",
      "type": "manual",
      "manual_info": {
        "commands": [
          "alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 312",
          "alternatives --set python3 /usr/bin/python3.12",
          "python3 -m pip install fabric invoke redis hiredis jsonschema"
        ]
      }
    },
    {
      "name": "stream_upstream",
      "type": "source",
      "source_info": {
        "url": "https://github.com/redhat-performance/streams-wrapper/archive/8932e7bfa6cf1c99360c10549887eeb1d457d27e.tar.gz",
        "filename": "streams-wrapper-8932e7bfa6cf1c99360c10549887eeb1d457d27e.tar.gz",
        "commands": {
          "unpack": "tar -xzf streams-wrapper-8932e7bfa6cf1c99360c10549887eeb1d457d27e.tar.gz",
          "get_dir": "echo streams-wrapper-8932e7bfa6cf1c99360c10549887eeb1d457d27e",
          "commands": [
            "python3 /tmp/stream-build.py --source-file streams/stream_omp_5_10.c --license-file /tmp/STREAM-5.10-LICENSE.txt --notice-file /tmp/STREAM-NOTICE.txt --adapter-license-file /tmp/STREAM-ADAPTER-LICENSE.txt"
          ]
        }
      }
    }
  ]
}
